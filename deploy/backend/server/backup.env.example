# /etc/poifo/backup.env（root:root 600）。この台で DB のバックアップを取る（通常は MIGRATE=true の1台だけに置く）
# IAM ユーザー poifo-backup-writer のアクセスキー（バックアップ用バケットに置くことだけできる。読めない・消せない）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
# terraform/base の output backup_bucket（poifo-backup-<アカウントID>）
BACKUP_BUCKET=
# 暗号化のパスフレーズを書いたファイル（root:root 600）。同じ値をパスワードマネージャーにも保存する（無くすと戻せない）
BACKUP_PASSPHRASE_FILE=/etc/poifo/backup.pass
