# /etc/poifo/server.env（root:root 600）。setup-server.sh が読む、サーバごとの設定
# CloudFront から届く秘密ヘッダー X-Origin-Verify の値（GitHub Secrets の ORIGIN_VERIFY_SECRET と同じ）。必須
ORIGIN_VERIFY_SECRET=
# オリジンのホスト名（origin.<domain>）。独自ドメインの段階になったら入れる。空なら HTTPS（443）を作らない
ORIGIN_HOST=
# Let's Encrypt の証明書を取るか（DNS で確認するので、入れ替え用の新しいサーバでも取れる）。
# LB なしの構成では true。LB ありなら LB が HTTPS を終端するので false でよい
ISSUE_CERT=false
# Let's Encrypt の期限切れ通知の宛先（空なら登録しない）
CERTBOT_EMAIL=
# スワップの大きさ（1GB のサーバでメモリ不足で落ちないように）
SWAP_SIZE=2G
