# /etc/poifo/deploy-agent.env（root:root 600）。値は Terraform の outputs と、コンソールで発行したアクセスキー
# IAM ユーザー poifo-deploy-agent のアクセスキー（リリースの読み取りと結果の書き込みだけできる）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
# terraform/app の output deploy_bucket（poifo-deploy-<アカウントID>）
DEPLOY_BUCKET=
# 以下は既定値のままでよい
APP_DIR=/var/www/poifo
APP_USER=www-data
PHP_FPM_SERVICE=php8.4-fpm
KEEP_RELEASES=5
