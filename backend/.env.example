# ローカル開発用の例。本番の値（秘密を含む）はサーバの .env にだけ置き、コミットしない
APP_NAME=POIFO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost:8000
APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

# メンテナンスモードを全サーバで共有する（台数を増やしても php artisan down が全台に効く）
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# ---- POIFO ----
# 閲覧者のホスト名（本番は api.<domain> / admin.<domain>）
POIFO_API_HOST=api.localhost
POIFO_ADMIN_HOST=admin.localhost
# x-poifo-viewer-host ヘッダーがないとき Host で代用する（ローカルだけ true。本番は false）
POIFO_ALLOW_HOST_FALLBACK=true
# フロント（Astro）の URL。本番は https://<domain>
POIFO_FRONT_URL=http://localhost:4321
# API 仕様書（http://api.localhost:8000/docs/api）とデバッグ用ログイン（/auth/debug/login）を出すか。
# 開発の確認中だけ true にする。本番は必ず false
POIFO_API_DOCS_ENABLED=false
POIFO_YEN_PER_POINT=1
POIFO_MIN_WITHDRAWAL_POINTS=1000
POIFO_WITHDRAWAL_REVIEW_DAYS=7

# ---- データベース ----
# ローカル: compose.yaml の MySQL（手早く試すなら DB_CONNECTION=sqlite にして DB_DATABASE の行を消す → database/database.sqlite）。本番: Lightsail マネージドDB（エンドポイントは Lightsail コンソールで確認）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poifo
DB_USERNAME=poifo
DB_PASSWORD=poifo
# 本番はマネージドDBへ TLS で接続する。AWS の CA バンドルのパス（例: /etc/ssl/certs/rds-global-bundle.pem）
MYSQL_ATTR_SSL_CA=

# ---- セッション・キャッシュ・キュー ----
# API サーバを複数台に増やせるよう、どれもサーバ内（file）ではなく共有の DB に置く
# セッション Cookie はフロントと API で共有するため、本番は SESSION_DOMAIN=.<domain>
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Cookie 認証を許可するフロントのホスト（本番は <domain>）
SANCTUM_STATEFUL_DOMAINS=localhost:4321

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# 管理者への通知メール。ローカルはログに出すだけ。
# 本番は Amazon SES（東京）の SMTP 587番（Lightsail は 25番が塞がっている）:
#   MAIL_MAILER=smtp / MAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com / MAIL_PORT=587
#   MAIL_USERNAME=送信用 IAM ユーザーのアクセスキー ID / MAIL_PASSWORD=そのシークレットキーから作った SMTP パスワード（README 参照）
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=POIFO

# ---- LINE ログイン（LINE Developers のチャネル。秘密の値はコミットしない） ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://api.localhost:8000/auth/line/callback
LINE_LOGIN_BOT_PROMPT=normal
LINE_OFFICIAL_FRIEND_URL=

# ---- GF Rewards（APIキーはポストバックのハッシュ検証にも使う） ----
GF_REWARDS_API_KEY=
GF_REWARDS_AD_CHANNEL_ID=
# 成果通知の URL に入れる推測されにくい文字列（https://api.<domain>/postback/<これ>/gf-rewards）。空なら受け付けない
POIFO_POSTBACK_PATH_TOKEN=local-postback-token
# 成果通知の送信元として許可する IP（カンマ区切り・CIDR 可。本番は ASP の送信元 IP。空なら本番では全て拒否、ローカルでは確認しない）
POIFO_POSTBACK_ALLOWED_IPS=
POIFO_POSTBACK_BURST_PER_MINUTE=30

# 送信元 IP を読むヘッダー（CloudFront Function が付ける）。ローカルはヘッダーがないので接続元の IP で代用する（本番は false）
POIFO_CLIENT_IP_HEADER=x-poifo-viewer-ip
POIFO_CLIENT_IP_FALLBACK=true

# 異常（成果通知の拒否・保留・大量受信など）を知らせる管理者のメールアドレス（カンマ区切り）
POIFO_ALERT_EMAILS=
