---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="案件を探す">
  <section class="section">
    <div class="container">
      <h1 class="section__title">案件を探す</h1>
      <p class="lead">案件はログインしてから利用してください（ログインしていないとポイントが付きません）。</p>
      <div id="campaigns" class="grid grid--2" aria-live="polite"><p class="loading">読み込み中…</p></div>
      <p><button id="more" class="btn btn--outline" type="button" hidden>もっと見る</button></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchCampaigns } from '../../lib/api';
  import { campaignCard, emptyState } from '../../lib/render';

  const list = document.getElementById('campaigns')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  let page = 1;

  async function load() {
    try {
      const res = await fetchCampaigns({ page, perPage: 20 });
      if (page === 1) list.innerHTML = res.data.length ? '' : emptyState('現在掲載中の案件はありません。');
      list.insertAdjacentHTML('beforeend', res.data.map(campaignCard).join(''));
      more.hidden = res.meta.current_page >= res.meta.last_page;
    } catch {
      list.innerHTML = emptyState('案件を読み込めませんでした。時間をおいて再度お試しください。');
    }
  }

  more.addEventListener('click', () => {
    page += 1;
    load();
  });
  load();
</script>
