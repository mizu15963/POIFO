---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Visual from '../../components/Visual.astro';
---

<BaseLayout title="案件を探す">
  <section class="section">
    <div class="container">
      <Visual
        name="campaigns-header"
        alt="いつものお買い物で、ゲームで、ポイ活。気になる案件を見つけよう"
        eager
        class="page-banner"
      />
      <h1 class="section__title" id="list-title">案件を探す</h1>
      <p class="lead">案件はログインしてから利用してください（ログインしていないとポイントが付きません）。</p>
      <!-- トップの案件メニュー（おすすめ・はじめて向け など）から来たときは、その説明と「すべての案件を見る」を出し、カテゴリのタブは出さない -->
      <p id="menu-note" class="menu-note" hidden><span id="menu-description"></span><a href="/campaigns/">すべての案件を見る</a></p>
      <nav id="categories" class="tabs" aria-label="カテゴリ" hidden></nav>
      <div id="campaigns" class="grid grid--2" aria-live="polite"><p class="loading">読み込み中…</p></div>
      <p><button id="more" class="btn btn--outline" type="button" hidden>もっと見る</button></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchCampaignCategories, fetchCampaigns } from '../../lib/api';
  import { escapeHtml } from '../../lib/format';
  import { bindFavoriteButtons } from '../../lib/favorite';
  import { campaignCard, emptyState, loadError } from '../../lib/render';
  import { campaignMenuFromSearch } from '../../lib/campaign-menu';

  const list = document.getElementById('campaigns')!;
  const tabs = document.getElementById('categories')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const search = new URLSearchParams(location.search);
  // ?category= で絞り込んだ状態を共有できるようにする
  let category = search.get('category') ?? '';
  // トップの案件メニュー（?featured=1・?tag=・?sort=points）で開いたとき
  const menu = campaignMenuFromSearch(search);
  let page = 1;
  bindFavoriteButtons(list);

  if (menu) {
    category = '';
    document.getElementById('list-title')!.textContent = menu.label;
    document.title = document.title.replace('案件を探す', menu.label);
    document.getElementById('menu-description')!.textContent = menu.description;
    document.getElementById('menu-note')!.hidden = false;
  }

  async function load() {
    try {
      const res = await fetchCampaigns({ page, perPage: 20, category: category || undefined, ...menu?.query });
      const emptyText = menu ? `${menu.label}は準備中です。` : '現在掲載中の案件はありません。';
      if (page === 1) list.innerHTML = res.data.length ? '' : emptyState(emptyText, 'point');
      list.insertAdjacentHTML('beforeend', res.data.map((c) => campaignCard(c)).join(''));
      more.hidden = res.meta.current_page >= res.meta.last_page;
    } catch {
      list.innerHTML = loadError('案件を読み込めませんでした。時間をおいて再度お試しください。');
    }
  }

  function renderTabs(names: string[]) {
    tabs.innerHTML = ['', ...names]
      .map((name) => `<button type="button" class="tab" data-category="${escapeHtml(name)}" aria-pressed="${name === category}">${escapeHtml(name || 'すべて')}</button>`)
      .join('');
    tabs.hidden = names.length === 0;
  }

  tabs.addEventListener('click', (ev) => {
    const button = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-category]');
    if (!button) return;
    category = button.dataset.category ?? '';
    tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    const url = new URL(location.href);
    if (category) url.searchParams.set('category', category);
    else url.searchParams.delete('category');
    history.replaceState(null, '', url);
    page = 1;
    list.innerHTML = '<p class="loading">読み込み中…</p>';
    load();
  });

  more.addEventListener('click', () => {
    page += 1;
    load();
  });

  if (!menu) {
    fetchCampaignCategories()
      .then((cats) => renderTabs(cats.map((c) => c.name)))
      .catch(() => renderTabs([]));
  }
  load();
</script>

<style>
  .menu-note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin: 0 0 16px;
    font-size: 0.9rem;
  }
  .menu-note a {
    font-weight: 700;
  }
</style>
