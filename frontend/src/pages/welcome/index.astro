---
// 初回登録（docs/specs/screen-spec.md S27、機能仕様 3.5）。先方の見本 brand/redesign/onboarding/first-registration-mobile.png に合わせる。
// LINE ログインのたびに、メールアドレスを入れていない会員はここに来る（?new=1 は初めての登録）。
// 警告の帯・案件詳細の「登録する」から来たときは ?back=<元のページ> で、登録後はそこへ戻す
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="初回登録" requireLogin noindex>
  <section class="section">
    <div class="container narrow">
      <p class="welcome-done">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"></circle><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>LINEログインが完了しました</span>
      </p>
      <h1 class="welcome-title">初回登録</h1>

      <form id="welcome-form" class="welcome-form" novalidate>
        <div class="welcome-field">
          <h2 class="welcome-field__head">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="1.5"></rect><path d="m3.5 6.5 8.5 6.5 8.5-6.5"></path></svg>
            <label for="email">メールアドレス</label>
            <span class="badge badge--required">必須</span>
          </h2>
          <p class="welcome-field__text">ポイフォで利用するメールアドレスを登録してください。</p>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="例：mail@example.com" maxlength="255" required aria-describedby="email-error" />
          <p id="email-error" class="field-error" role="alert" hidden></p>
          <p class="welcome-field__note">ポイント交換の連絡などに使います。ログインはこれまでどおりLINEです。</p>
        </div>

        <fieldset class="welcome-field">
          <legend class="welcome-field__head">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 4l9 5.5Z"></path><path d="M5.5 10v7M10 10v7M14 10v7M18.5 10v7M3 20h18"></path></svg>
            <span>振込先口座</span>
            <span class="badge badge--optional">任意</span>
          </legend>
          <p class="welcome-field__text">ポイント交換を申請するときに必要です。あとから登録できます。</p>
          <label class="welcome-radio"><input type="radio" name="bank" value="skip" checked /><span>今はスキップする</span></label>
          <label class="welcome-radio"><input type="radio" name="bank" value="now" /><span>続けて口座を登録する</span></label>
        </fieldset>

        <p id="form-error" class="form-errors" role="alert" hidden></p>
        <button class="btn btn--block welcome-submit" type="submit">メールを登録して始める</button>
      </form>

      <p class="welcome-logout"><button type="button" id="logout">ログアウト</button></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { ApiError, logout, registerEmail } from '../../lib/api';
  import { safeBackPath } from '../../lib/email';
  import { whenMe } from '../../lib/session';

  const params = new URLSearchParams(location.search);
  const back = safeBackPath(params.get('back'));
  const isNew = params.get('new') === '1';
  // 登録後の行き先。元のページがあればそこへ（案件詳細ならそのまま「この案件に進む」を押せる）、なければ登録完了（S07）
  const done = back ?? `/auth/complete/?${isNew ? 'new=1&' : ''}email=sent`;

  const form = document.getElementById('welcome-form') as HTMLFormElement;
  const input = document.getElementById('email') as HTMLInputElement;
  const fieldError = document.getElementById('email-error')!;
  const formError = document.getElementById('form-error')!;

  whenMe().then((me) => {
    // すでに入れている人（確認待ちを含む）は用がないので戻す
    if (me?.email_registered) location.replace(back ?? '/');
  });

  const showFieldError = (message: string) => {
    fieldError.textContent = message;
    fieldError.hidden = false;
    input.setAttribute('aria-invalid', 'true');
    input.focus();
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    fieldError.hidden = true;
    formError.hidden = true;
    input.removeAttribute('aria-invalid');
    const email = input.value.trim();
    if (!email) return showFieldError('メールアドレスを入力してください。');
    if (!input.checkValidity()) return showFieldError('メールアドレスの形式が正しくありません。');

    const button = form.querySelector<HTMLButtonElement>('.welcome-submit')!;
    button.disabled = true;
    try {
      await registerEmail(email);
      const bankNow = (form.elements.namedItem('bank') as RadioNodeList).value === 'now';
      location.href = bankNow ? `/mypage/bank/?next=${encodeURIComponent(done)}` : done;
    } catch (err) {
      button.disabled = false;
      if (err instanceof ApiError && err.status === 422 && err.errors.email?.length) {
        showFieldError(err.errors.email[0]);
      } else {
        formError.textContent = '登録できませんでした。時間をおいてもう一度お試しください。';
        formError.hidden = false;
      }
    }
  });

  document.getElementById('logout')!.addEventListener('click', async () => {
    await logout().catch(() => undefined);
    location.href = '/';
  });
</script>

<style>
  .welcome-done {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 0 20px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--color-brand-bg);
    color: var(--color-brand-strong);
    font-weight: 800;
  }
  .welcome-done span {
    color: var(--color-text);
  }
  .welcome-title {
    margin: 0 0 20px;
    text-align: center;
    font-size: 1.8rem;
  }
  .welcome-form {
    display: grid;
    gap: 24px;
  }
  .welcome-field {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .welcome-field__head {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin: 0 0 12px;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .welcome-field__head svg {
    color: var(--color-brand-strong);
    flex-shrink: 0;
  }
  .badge {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .badge--required {
    background: var(--color-brand-strong);
    color: #fff;
  }
  .badge--optional {
    background: var(--color-border);
    color: var(--color-muted);
  }
  .welcome-field__text {
    margin: 0 0 10px;
  }
  .welcome-field input[type='email'] {
    width: 100%;
    font: inherit;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #fff;
  }
  .welcome-field input[type='email']:focus {
    outline: 2px solid var(--color-brand);
    border-color: var(--color-brand);
  }
  .welcome-field input[aria-invalid='true'] {
    border-color: var(--color-danger);
  }
  .field-error {
    margin: 6px 0 0;
    color: var(--color-danger);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .welcome-field__note {
    margin: 6px 0 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .welcome-radio {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    cursor: pointer;
  }
  .welcome-radio input {
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--color-brand-strong);
  }
  .welcome-submit {
    min-height: 54px;
    font-size: 1.05rem;
  }
  .welcome-logout {
    margin-top: 24px;
    text-align: center;
  }
  .welcome-logout button {
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
