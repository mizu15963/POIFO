---
// お気に入り（docs/specs/screen-spec.md S24）
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="お気に入り" requireLogin noindex>
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h1 class="section__title">お気に入り</h1>
        <span class="lead" id="count"></span>
      </div>
      <div id="favorites" class="grid grid--2" aria-live="polite"><p class="loading">読み込み中…</p></div>
      <p><button id="more" class="btn btn--outline" type="button" hidden>もっと見る</button></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchFavorites } from '../../../lib/api';
  import { bindFavoriteButtons } from '../../../lib/favorite';
  import { campaignCard, emptyState } from '../../../lib/render';
  import { whenMe } from '../../../lib/session';

  const list = document.getElementById('favorites')!;
  const more = document.getElementById('more') as HTMLButtonElement;
  const count = document.getElementById('count')!;
  let page = 1;
  let total = 0;
  let limit = 200;

  const showEmpty = () =>
    (list.innerHTML = `${emptyState('お気に入りはまだありません。気になる案件の☆を押すと、ここにまとまります。')}<a class="btn" href="/campaigns/">案件を探す</a>`);
  const showCount = () => (count.textContent = `${total.toLocaleString('ja-JP')}件／${limit.toLocaleString('ja-JP')}件`);

  async function load() {
    try {
      const res = await fetchFavorites(page);
      total = res.meta.total;
      limit = res.meta.limit;
      showCount();
      if (page === 1) list.innerHTML = '';
      if (!res.data.length && page === 1) {
        showEmpty();
        return;
      }
      list.insertAdjacentHTML('beforeend', res.data.map((c) => campaignCard(c, { ended: !c.listed })).join(''));
      more.hidden = res.meta.current_page >= res.meta.last_page;
    } catch {
      list.innerHTML = emptyState('お気に入りを読み込めませんでした。時間をおいて再度お試しください。');
    }
  }

  // 外したらその場で消す（もう一度付け直したいときは案件詳細から）
  bindFavoriteButtons(list, {
    onChange: (_id, on, button) => {
      if (on) return;
      button.closest('.campaign-card')?.remove();
      total = Math.max(0, total - 1);
      showCount();
      if (!list.querySelector('.campaign-card') && more.hidden) showEmpty();
    },
  });
  more.addEventListener('click', () => {
    page += 1;
    load();
  });
  whenMe().then((me) => me && load());
</script>
