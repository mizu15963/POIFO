---
// ポイント交換＝交換先の一覧（docs/specs/screen-spec.md S12）。交換先が1つでも一覧を出し、選んで詳細（S20）へ進む
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="ポイント交換" requireLogin noindex>
  <section class="section">
    <div class="container narrow">
      <h1 class="section__title">ポイント交換</h1>
      <div class="card exchange-balance">
        <span class="lead">交換できるポイント</span>
        <span class="exchange-balance__value" id="available">—</span>
      </div>
      <div id="methods" aria-live="polite"><p class="loading">読み込み中…</p></div>
      <p><a class="more-link" href="/mypage/?tab=exchanges">交換履歴を見る</a></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchExchangeMethods, type ExchangeMethod } from '../../../lib/api';
  import { escapeHtml, formatPoints, safeUrl } from '../../../lib/format';
  import { exchangeFeeText } from '../../../lib/exchange';
  import { emptyState, loadError } from '../../../lib/render';
  import { whenMe } from '../../../lib/session';

  const root = document.getElementById('methods')!;

  const card = (m: ExchangeMethod) => {
    const icon = safeUrl(m.icon);
    return `
      <a class="card method-card" href="/mypage/withdraw/detail/?method=${encodeURIComponent(m.code)}">
        ${icon ? `<img src="${escapeHtml(icon)}" alt="" width="48" height="48">` : '<span class="method-card__icon" aria-hidden="true">¥</span>'}
        <span class="method-card__body">
          <span class="method-card__name">${escapeHtml(m.name)}${m.accepting ? '' : '<span class="badge badge--muted">受付停止中</span>'}</span>
          <span class="method-card__desc">${escapeHtml(m.description)}</span>
          <span class="method-card__terms">
            <span>最低 ${escapeHtml(formatPoints(m.min_points))}</span>
            <span>手数料 ${escapeHtml(exchangeFeeText(m))}</span>
            ${m.delivery_note ? `<span>${escapeHtml(m.delivery_note)}</span>` : ''}
          </span>
        </span>
      </a>`;
  };

  whenMe().then(async (me) => {
    if (!me) return;
    document.getElementById('available')!.textContent = formatPoints(me.points.available);
    try {
      const methods = await fetchExchangeMethods();
      if (!methods.length) {
        root.innerHTML = emptyState('交換先は準備中です。', 'cheer');
        return;
      }
      // 交換先の種類が増えたら、カテゴリ（現金・ギフト券など）ごとに見出しを付けて分ける
      const groups = new Map<string, ExchangeMethod[]>();
      for (const m of methods) groups.set(m.category, [...(groups.get(m.category) ?? []), m]);
      const grouped = groups.size > 1;
      root.innerHTML = [...groups]
        .map(([category, items]) => `${grouped && category ? `<h2 class="method-group">${escapeHtml(category)}</h2>` : ''}<div class="grid">${items.map(card).join('')}</div>`)
        .join('');
    } catch {
      root.innerHTML = loadError('交換先を読み込めませんでした。時間をおいて再度お試しください。');
    }
  });
</script>

<style>
  .exchange-balance {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
    background: var(--color-accent-bg);
    border-color: var(--color-accent);
  }
  .exchange-balance__value {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-accent-strong);
  }
  #methods :global(.method-card) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  #methods :global(.method-card img),
  #methods :global(.method-card__icon) {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 12px;
  }
  #methods :global(.method-card__icon) {
    display: grid;
    place-items: center;
    background: var(--color-brand-bg);
    font-size: 1.3rem;
    font-weight: 700;
  }
  #methods :global(.method-card__body) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  #methods :global(.method-card__name) {
    font-weight: 700;
  }
  #methods :global(.method-card__desc) {
    font-size: 0.85rem;
  }
  #methods :global(.method-card__terms) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  #methods :global(.method-group) {
    margin: 20px 0 8px;
    font-size: 1rem;
  }
</style>
