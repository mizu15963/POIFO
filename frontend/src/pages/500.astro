---
// 500系のエラーページ。CloudFront がオリジンの 500/502/503/504 でこのページを返す（terraform/app/front.tf）。
// 障害時に表示するので、共通 CSS・API に頼らない StandaloneLayout を使う。
import StandaloneLayout from '../layouts/StandaloneLayout.astro';
import Mascot from '../components/Mascot.astro';
---

<StandaloneLayout title="ただいまつながりにくくなっています">
  <Mascot pose="sorry" width={180} eager />
  <p class="code">500 Server Error</p>
  <h1>ただいま<br />つながりにくくなっています</h1>
  <p class="text">
    ご不便をおかけして申し訳ありません。時間をおいて、もう一度お試しください。獲得済みのポイントが消えることはありません。
  </p>
  <div class="actions">
    <button class="btn" type="button" onclick="location.reload()">再読み込みする</button>
    <a class="btn btn--outline" href="/">トップへ戻る</a>
  </div>
</StandaloneLayout>
