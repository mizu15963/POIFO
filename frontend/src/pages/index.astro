---
// トップページ（docs/specs/screen-spec.md S01）
import BaseLayout from '../layouts/BaseLayout.astro';
import HowToEarn from '../components/HowToEarn.astro';
import Mascot from '../components/Mascot.astro';
import Visual from '../components/Visual.astro';
import { LINE_LOGIN_URL, LINE_OFFICIAL_URL } from '../lib/config';
---

<BaseLayout>
  <!-- ② ファーストビュー -->
  <!-- キービジュアル kv-aqua-mascot はコピーと説明文が画像に入っているので、見出しは画面に出さず HTML にも書く（検索・読み上げ用） -->
  <section class="hero">
    <h1 class="sr-only">ひとりじゃない、あたらしいポイ活。</h1>
    <Visual
      name="kv-aqua-mascot"
      alt="ひとりじゃない、あたらしいポイ活。ポイントを貯める楽しさに、相談できる安心と、みんなで取り組むワクワクを。"
      eager
    />
    <div class="container hero__inner">
      <div class="hero__cta">
        <div data-show="guest">
          <a class="btn btn--line" href={LINE_LOGIN_URL}>LINEで無料で始める</a>
        </div>
        <div data-show="member">
          <a class="btn" href="/campaigns/">ポイントを貯める</a>
        </div>
      </div>
      <ul class="hero__points">
        <li>登録・利用は無料</li>
        <li>LINEでかんたん登録</li>
        <li>担当スタッフに相談できる</li>
      </ul>
    </div>
  </section>

  <!-- ③ 案件を探す：カテゴリ → おすすめ案件 -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">カテゴリから探す</h2>
        <a class="section__more" href="/campaigns/">すべて見る</a>
      </div>
      <ul id="campaign-categories" class="category-tiles" aria-live="polite">
        <li class="loading">読み込み中…</li>
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">おすすめ案件</h2>
        <a class="section__more" href="/campaigns/">すべて見る</a>
      </div>
      <div id="featured-campaigns" class="grid grid--2 hscroll hscroll--campaigns" aria-live="polite">
        <p class="loading">読み込み中…</p>
      </div>
    </div>
  </section>

  <!-- ⑤ みんなでポイ活（イベント） -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">みんなでポイ活！</h2>
        <a class="section__more" href="/events/">一覧を見る</a>
      </div>
      <div class="with-mascot">
        <p class="lead with-mascot__body">ゲーム案件などに、みんなで楽しく挑戦。イベント情報をチェックしよう！</p>
        <Mascot pose="event" width={150} />
      </div>
      <div id="upcoming-events" class="grid grid--3 hscroll hscroll--events" aria-live="polite">
        <p class="loading">読み込み中…</p>
      </div>
    </div>
  </section>

  <!-- ④ 担当サポート -->
  <section class="section">
    <div class="container">
      <h2 class="section__title">困ったときは、担当スタッフに相談。</h2>
      <div class="with-mascot">
        <p class="with-mascot__body">ポイントの貯め方や案件の進め方を、LINEで気軽に相談できます。初回面談の日程もLINEで調整します。</p>
        <Mascot pose="line" width={150} />
      </div>
      {LINE_OFFICIAL_URL ? <a class="btn btn--line" href={LINE_OFFICIAL_URL} rel="noopener">公式LINEで相談する</a> : <a class="btn btn--outline" href="/support/">担当サポートについて</a>}
    </div>
  </section>

  <!-- ⑥ ポイフォの特徴 -->
  <section class="section section--soft">
    <div class="container">
      <h2 class="section__title section__title--center">ポイフォの特徴</h2>
      <div class="grid grid--3 features">
        <div class="card feature"><Visual name="feature-smartphone" alt="" class="feature__img" /><h3>自由にポイ活</h3><p>興味のある案件を、自分のペースで利用できます。</p></div>
        <div class="card feature"><Visual name="feature-chat" alt="" class="feature__img" /><h3>担当者に相談</h3><p>公式LINEで気軽にサポートを受けられます。</p></div>
        <div class="card feature"><Visual name="feature-people" alt="" class="feature__img" /><h3>みんなで楽しむ</h3><p>イベントやオープンチャットで一緒に取り組めます。</p></div>
      </div>
    </div>
  </section>

  <!-- ⑦ 初めての方へ：貯め方 → しくみ → 交換先 → よくある質問 → 登録 -->
  <section class="section">
    <div class="container">
      <h2 class="section__title section__title--center">ポイントの貯め方</h2>
      <HowToEarn />
      <a class="more-link" href="/guide/#earn">くわしい貯め方を見る</a>
    </div>
  </section>

  <section class="section section--warm">
    <div class="container">
      <h2 class="section__title section__title--center">ポイントがもらえるしくみ</h2>
      <!-- 説明画像 how-points-work（文言入り）。図の流れも alt に書いて読み上げで伝わるようにする -->
      <Visual
        name="how-points-work"
        class="howitworks"
        alt="ポイフォの登録は無料なのに、なぜポイントが貯まるの？ポイフォに掲載されている広告を利用すると、企業からポイフォへ広告費が支払われます。その広告費の一部をポイントとして還元しています。1. ユーザー様がポイフォを経由して広告を利用 2. 企業がポイフォに広告費を支払い 3. ポイフォがユーザー様にポイントとして還元"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title section__title--center">貯めたポイントの使い道</h2>
      <Visual name="banner-wide-plain" alt="" class="exchange__visual" />
      <div class="exchange card">
        <div class="exchange__body">
          <p class="exchange__name">現金（銀行振込）</p>
          <p class="exchange__text">確定したポイントを、登録した銀行口座への振込で受け取れます。交換先は今後追加予定です。</p>
          <a class="more-link" href="/guide/#exchange">交換方法を見る</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2 class="section__title section__title--center">よくある質問</h2>
      <div class="faq-intro">
        <Mascot pose="guide" width={110} />
        <p class="faq-intro__bubble">はじめての方からよく聞かれることをまとめたよ。タップすると答えが開きます。</p>
      </div>
      <div class="faq">
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>登録や利用にお金はかかりますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>かかりません。会員登録・案件の利用・ポイント交換の申請は無料です（案件によっては、広告主のサービス自体が有料のものがあります）。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>どうやって会員登録しますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>「LINEで無料で始める」からLINEでログインするだけで登録できます。メールアドレスやパスワードの入力はいりません。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>ポイントはいつもらえますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>条件を達成すると、まず「判定中」として反映されます。広告主の承認後に「確定」となり、交換に使えるようになります。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>困ったときは誰に相談できますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>ポイフォ公式LINEを友だち追加すると、担当スタッフに相談できます。</p></div>
        </details>
      </div>
      <a class="more-link" href="/guide/">ヘルプをもっと見る</a>
    </div>
  </section>

  <!-- 最後の登録導線（未ログインのときだけ） -->
  <section class="section section--wave final-cta" data-show="guest">
    <div class="container">
      <Mascot pose="wave" width={120} class="final-cta__img" />
      <p class="final-cta__copy">ひとりじゃない、あたらしいポイ活をはじめよう。</p>
      <a class="btn btn--line" href={LINE_LOGIN_URL}>LINEで無料で始める</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchCampaignCategories, fetchCampaigns, fetchEvents } from '../lib/api';
  import { escapeHtml } from '../lib/format';
  import { campaignCard, emptyState, eventCard } from '../lib/render';

  // カテゴリは ASP から取り込んだ案件の分類（件数の多い順）。上位だけを出し、残りは案件一覧で絞り込む
  const categories = document.getElementById('campaign-categories')!;
  fetchCampaignCategories()
    .then((items) => {
      categories.innerHTML = items.length
        ? items
            .slice(0, matchMedia('(max-width: 639px)').matches ? 9 : 8)
            .map((c) => `<li><a class="category-tile" href="/campaigns/?category=${encodeURIComponent(c.name)}"><span class="category-tile__name">${escapeHtml(c.name)}</span><span class="category-tile__count">${c.count}件</span></a></li>`)
            .join('')
        : `<li>${emptyState('カテゴリは準備中です。')}</li>`;
    })
    .catch(() => (categories.innerHTML = `<li>${emptyState('カテゴリを読み込めませんでした。')}</li>`));

  const campaigns = document.getElementById('featured-campaigns')!;
  fetchCampaigns({ featured: true, perPage: 6 })
    .then(async (res) => {
      // おすすめが未設定なら新着を出す
      const items = res.data.length ? res.data : (await fetchCampaigns({ perPage: 6 })).data;
      campaigns.innerHTML = items.length ? items.map(campaignCard).join('') : emptyState('現在掲載中の案件はありません。');
    })
    .catch(() => (campaigns.innerHTML = emptyState('案件を読み込めませんでした。時間をおいて再度お試しください。')));

  const events = document.getElementById('upcoming-events')!;
  fetchEvents({ upcoming: true, limit: 3 })
    .then((items) => (events.innerHTML = items.length ? items.map(eventCard).join('') : emptyState('開催予定のイベントは準備中です。')))
    .catch(() => (events.innerHTML = emptyState('イベントを読み込めませんでした。')));
</script>

<style>
  /* ファーストビューはキービジュアル（画像の下端が濃いアクアの波）の下に、主ボタンと特徴3つを置く */
  .hero {
    background: linear-gradient(180deg, var(--color-brand-bg), #fff);
    padding: 0 0 20px;
  }
  .hero__inner {
    padding-top: 16px;
    text-align: center;
  }
  .hero__cta .btn {
    width: 100%;
  }
  .hero__points {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__points li {
    padding: 4px 12px;
    border: 1px solid var(--color-brand);
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
  }
  /* カテゴリはスマホ2列・PC4列のタイル。件数を添えて、どこに案件が多いか分かるようにする */
  .category-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* タイルはスクリプトで差し込むので :global で当てる（Astro のスコープ付きスタイルが効かないため） */
  .category-tiles > :global(li:only-child) {
    grid-column: 1 / -1;
  }
  .category-tiles :global(.category-tile) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .category-tiles :global(.category-tile:hover) {
    border-color: var(--color-brand);
    background: var(--color-brand-bg);
  }
  .category-tiles :global(.category-tile__name) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .category-tiles :global(.category-tile__count) {
    color: var(--color-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  /* 説明画像は白地なので、淡いオレンジの背景の上でカードのように角を丸める */
  .section :global(.howitworks) {
    border-radius: var(--radius);
  }
  .exchange {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .section :global(.exchange__visual) {
    border-radius: var(--radius) var(--radius) 0 0;
  }
  /* バナーの下にカードをつなげて、絵と説明を1つのまとまりに見せる */
  .section :global(.exchange__visual) + .exchange {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .exchange__body {
    min-width: 0;
  }
  .exchange__name {
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0 0 4px;
  }
  .exchange__text {
    margin: 0;
  }
  .faq-intro {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .faq-intro :global(.mascot) {
    width: 96px;
    flex-shrink: 0;
  }
  /* キャラクターの吹き出し（左向きのしっぽ付き） */
  .faq-intro__bubble {
    position: relative;
    margin: 0;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.9rem;
  }
  .faq-intro__bubble::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 50%;
    width: 12px;
    height: 12px;
    background: #fff;
    border-left: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    transform: translateY(-50%) rotate(45deg);
  }
  .faq {
    display: grid;
    gap: 8px;
  }
  .faq details {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .faq summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 40px 12px 14px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    position: relative;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  /* 開閉の印（＋／－） */
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 16px;
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 400;
  }
  .faq details[open] summary::after {
    content: '−';
  }
  .faq__answer {
    display: flex;
    gap: 10px;
    padding: 0 14px 14px;
  }
  .faq__answer p {
    margin: 0;
  }
  .faq__mark {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: 50%;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .faq__mark--q {
    background: var(--color-brand-bg);
    border: 1px solid var(--color-brand);
  }
  .faq__mark--a {
    background: var(--color-accent);
    color: var(--color-text);
  }
  .final-cta {
    text-align: center;
  }
  .final-cta :global(.final-cta__img) {
    display: block;
    margin: 0 auto 8px;
    width: 120px;
  }
  .feature {
    text-align: center;
  }
  .feature :global(.feature__img) {
    display: block;
    width: 96px;
    margin: 0 auto 8px;
  }
  .final-cta__copy {
    font-weight: 600;
    font-size: 1.15rem;
    margin: 0 0 16px;
  }
  /* スマホ向けの上書きは PC 向けの指定より後に置く（同じ詳細度なので後勝ち） */
  /* ===== スマホ（主なターゲット）: 一般的なポイントサイトのスマホ表示に寄せて、詰めて横に流す ===== */
  .hero__points {
    margin-top: 14px;
    gap: 6px;
  }
  .hero__points li {
    font-size: 0.75rem;
    padding: 2px 10px;
  }
  /* 案件とイベントは横スクロールのカード列にし、画面の端まで流して「続きがある」ことを見せる */
  .hscroll:has(.card) {
    grid-auto-flow: column;
    grid-template-columns: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 -16px;
    padding: 2px 16px 8px;
    scroll-padding-left: 16px;
    scrollbar-width: none;
  }
  .hscroll::-webkit-scrollbar {
    display: none;
  }
  .hscroll > :global(.card) {
    scroll-snap-align: start;
  }
  .hscroll--campaigns:has(.card) {
    grid-auto-columns: 42%;
  }
  .hscroll--events:has(.card) {
    grid-auto-columns: 78%;
  }
  /* 案件カードは縦長にして、アイコン → 名前（2行まで）→ ポイントの順に並べる */
  .hscroll--campaigns :global(.campaign-card) {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 12px;
  }
  .hscroll--campaigns :global(.campaign-card img),
  .hscroll--campaigns :global(.campaign-card__noicon) {
    width: 64px;
    height: 64px;
  }
  .hscroll--campaigns :global(.campaign-card__body) {
    width: 100%;
  }
  .hscroll--campaigns :global(.campaign-card__name) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    white-space: normal;
    font-size: 0.85rem;
    line-height: 1.4;
    min-height: 2.8em;
  }
  .hscroll--campaigns :global(.campaign-card__points) {
    font-size: 1rem;
  }
  .hscroll--events :global(.event-card) {
    padding: 12px;
  }
  /* 特徴は3つ横並びの小さなカードにして縦に長くしない */
  .features {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .features :global(.card) {
    padding: 10px;
  }
  .features :global(.feature__img) {
    width: 64px;
    margin-bottom: 4px;
  }
  .features h3 {
    font-size: 0.85rem;
    margin: 0 0 4px;
  }
  .features p {
    font-size: 0.75rem;
    line-height: 1.5;
    margin: 0;
  }
  .category-tiles {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  .category-tiles :global(.category-tile) {
    flex-direction: column;
    justify-content: center;
    gap: 0;
    min-height: 56px;
    padding: 6px;
    text-align: center;
  }
  .category-tiles :global(.category-tile__name) {
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .category-tiles :global(.category-tile__count) {
    font-size: 0.7rem;
  }
  .faq details {
    font-size: 0.9rem;
  }
  .faq-intro :global(.mascot) {
    width: 80px;
  }

</style>
