---
// トップページ（docs/specs/screen-spec.md S01）
// 2026-11-27 先方のデザイン更新（完成イメージは共有フォルダ brand/redesign/mockup/top-mobile.png）に合わせた並び。
// 説明のセクションは文字入りの納品画像なので、見出しは画面に出さない形（sr-only）で HTML にも書き、画像の alt に文言を入れる。
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
import Visual from '../components/Visual.astro';
import PointCard from '../components/PointCard.astro';
import EmailWarning from '../components/EmailWarning.astro';
import { CAMPAIGN_MENU, campaignMenuHref } from '../lib/campaign-menu';
import { LINE_LOGIN_URL, LINE_OFFICIAL_URL } from '../lib/config';

// 案件メニューの画像（section-category-menu）の中で、5行それぞれのカードがある位置（画像の高さに対する %）。
// 画像を差し替えたら測り直す（brand/redesign/README.md）
const MENU_ROWS = [
  [3.0, 16.6],
  [23.1, 16.2],
  [42.7, 16.5],
  [62.2, 16.3],
  [81.8, 15.4],
];
---

<BaseLayout>
  <!-- ログイン中の並び（docs/specs/screen-spec.md S01）: 保有ポイント → 重要なお知らせ → 案件メニュー → おすすめ → みんなでポイ活 → 担当スタッフ → よくある質問。
       初めての人向けの説明（ファーストビュー・特徴・貯め方・しくみ・最後の登録導線）はログイン中は出さない -->
  <section class="member-top" data-show="member">
    <div class="container">
      <!-- メールアドレス未登録のときだけ、一番上に警告の帯（機能仕様 3.5） -->
      <EmailWarning />
      <!-- ポイントの帯: サイト共通のポイントカード（docs/brand/README.md「ポイント表示の共通カード」） -->
      <PointCard label="利用可能ポイント" valueId="member-available" sideId="member-pending" href="/mypage/" />
      <a id="important-news" class="important-news" href="#" hidden></a>
    </div>
  </section>

  <!-- ① ファーストビュー: キービジュアル → 主ボタン → チップ3つ。のぞき込むポイフォックスをキービジュアルの下の縁に乗せる -->
  <section class="hero" data-show="guest">
    <h1 class="sr-only">ひとりじゃない、あたらしいポイ活。</h1>
    <div class="hero__kv">
      <Visual
        name="kv-hitori-janai"
        alt="ひとりじゃない、あたらしいポイ活。ポイントを貯める楽しさに、相談できる安心と、みんなで取り組むワクワクを。LINEで相談できる。みんなでポイ活。月末締め・翌月まとめ払い。"
        eager
      />
      <Mascot pose="peek" width={132} eager class="peek peek--kv" />
    </div>
    <div class="container hero__inner">
      <a class="btn btn--line hero__btn" href={LINE_LOGIN_URL}>LINEで無料で始める</a>
      <ul class="hero__chips">
        <li>登録・利用は無料</li>
        <li>LINEでかんたん登録</li>
        <li>担当スタッフに相談できる</li>
      </ul>
    </div>
  </section>

  <!-- ② ログイン中: カテゴリから探す（ASP のカテゴリをアイコン付きのタイルで。件数の多い順に8件） -->
  <section class="section section--tight" data-show="member">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">カテゴリから探す</h2>
        <a class="section__more" href="/campaigns/">すべて見る</a>
      </div>
      <ul id="campaign-categories" class="category-tiles" aria-live="polite">
        <li class="loading">読み込み中…</li>
      </ul>
    </div>
  </section>

  <!-- ② 未ログイン: 案件メニュー（5行）。絵は1枚の画像なので、行ごとに透明なリンクを重ねる。リンクの文字は読み上げ用に sr-only で持つ -->
  <section class="section section--tight" data-show="guest">
    <div class="container">
      <h2 class="sr-only">案件を探す</h2>
      <nav class="campaign-menu" aria-label="案件メニュー">
        <Visual name="section-category-menu" alt="" />
        <ul>
          {
            CAMPAIGN_MENU.map((m, i) => (
              <li style={`top:${MENU_ROWS[i][0]}%;height:${MENU_ROWS[i][1]}%`}>
                <a href={campaignMenuHref(m)}>
                  <span class="sr-only">
                    {m.label}（{m.description}）
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- ③ おすすめ案件 -->
  <section class="section section--tight">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">おすすめ案件</h2>
        <a class="section__more" href="/campaigns/?featured=1">すべて見る</a>
      </div>
      <div id="featured-campaigns" class="grid grid--2 hscroll hscroll--campaigns" aria-live="polite">
        <p class="loading">読み込み中…</p>
      </div>
    </div>
  </section>

  <!-- ④ みんなでポイ活: 未ログインは画像＋淡いアクアの帯にイベント、ログイン中は水色の囲みに見出し・説明文・イベント -->
  <section class="section section--tight" data-show="guest">
    <div class="container">
      <h2 class="sr-only">みんなでポイ活</h2>
      <Visual
        name="section-minna-de-poikatsu"
        class="section-visual"
        alt="みんなでポイ活。1人では続かない…。そんな人も、みんなでフォローしながらポイ活！イベントで一緒に挑戦。オープンチャットで相談。みんなで楽しく継続。イベントやオープンチャットで取り組める、新しいポイ活スタイルです。"
      />
    </div>
  </section>
  <section class="section section--soft events-band">
    <div class="container">
      <div class="section__head" data-show="member">
        <h2 class="section__title">みんなでポイ活！</h2>
        <a class="section__more" href="/events/">一覧を見る</a>
      </div>
      <p class="events-band__lead" data-show="member">ゲーム案件などに、みんなで楽しく挑戦。イベント情報をチェックしよう！</p>
      <div id="upcoming-events" class="grid grid--3 hscroll hscroll--events" aria-live="polite">
        <p class="loading">読み込み中…</p>
      </div>
      <a class="more-link" href="/events/" data-show="guest">イベント一覧を見る</a>
    </div>
  </section>

  <!-- ⑤ 担当スタッフに相談: 未ログインは画像＋公式LINE -->
  <section class="section" data-show="guest">
    <div class="container">
      <h2 class="sr-only">担当スタッフに相談</h2>
      <Visual
        name="section-staff-consult"
        class="section-visual"
        alt="ポイ活を始めたいけど、条件も複雑でよくわからない…。1万円を貯めたいけど、何を進めたらいいかわからない…。担当スタッフに相談。そんな時はポイフォにお任せ！わからないことを相談。おすすめ案件を相談。どれくらい進めればいいか相談。困ったらLINEで気軽に相談。初回面談の日程もLINEで調整できます。"
      />
      {LINE_OFFICIAL_URL ? <a class="btn btn--line section-btn" href={LINE_OFFICIAL_URL} rel="noopener">公式LINEで相談する</a> : <a class="btn btn--outline section-btn" href="/support/">担当サポートについて</a>}
    </div>
  </section>

  <!-- ⑤ ログイン中: 見出し・説明文・「担当サポートについて」と、右に絵 -->
  <section class="section section--tight" data-show="member">
    <div class="container">
      <h2 class="section__title">困ったときは、担当スタッフに相談。</h2>
      <div class="support-box">
        <div class="support-box__body">
          <p>ポイントの貯め方や案件の進め方を、LINEで気軽に相談できます。初回面談の日程もLINEで調整します。</p>
          <a class="btn btn--outline support-box__btn" href="/support/">担当サポートについて</a>
        </div>
        <Visual name="member-support" alt="" class="support-box__img" />
      </div>
    </div>
  </section>

  <!-- ⑥ ポイフォの特徴 → ⑦ 貯め方 → ⑧ しくみ（初めての人向け。画像） -->
  <section class="section section--tight" data-show="guest">
    <div class="container">
      <h2 class="sr-only">ポイフォの特徴</h2>
      <Visual
        name="section-features"
        class="section-visual"
        alt="ポイフォの特徴。自由にポイ活：興味のある案件を、自分のペースで利用できます。担当者に相談：公式LINEで気軽にサポートを受けられます。みんなで楽しむ：イベントやオープンチャットで一緒に取り組めます。"
      />
    </div>
  </section>

  <section class="section section--tight" data-show="guest">
    <div class="container">
      <h2 class="sr-only">ポイントの貯め方</h2>
      <Visual
        name="section-how-to-earn"
        class="section-visual"
        alt="ポイントの貯め方。STEP1 LINEでかんたん登録：LINEでログインするだけ。面倒な入力はありません。STEP2 案件を選んで進む：自分に合う案件を選び、『この広告に進む』をタップします。STEP3 条件達成でポイントGET：条件を達成するとポイントが反映。月末締め・翌月まとめ払いです。"
      />
      <a class="more-link" href="/guide/#earn">くわしい貯め方を見る</a>
    </div>
  </section>

  <section class="section section--tight" data-show="guest">
    <div class="container">
      <h2 class="sr-only">ポイントがもらえるしくみ</h2>
      <Visual
        name="section-how-points-work"
        class="section-visual"
        alt="ポイントがもらえるしくみ。ポイフォの登録は無料なのに、なぜポイントが貯まるの？ポイフォに掲載されている広告を利用すると、企業からポイフォへ広告費が支払われます。その広告費の一部をポイントとして還元しています。1. ユーザー様がポイフォを経由して広告を利用 2. 企業がポイフォに広告費を支払い 3. ポイフォがユーザー様にポイントとして還元"
      />
    </div>
  </section>

  <section class="section section--soft faq-section">
    <div class="container">
      <h2 class="section__title section__title--center">よくある質問</h2>
      <p class="faq-intro">はじめての方からよく聞かれることをまとめました。タップすると答えが開きます。</p>
      <div class="faq">
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>登録や利用にお金はかかりますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>かかりません。会員登録・案件の利用・ポイント交換の申請は無料です（案件によっては、広告主のサービス自体が有料のものがあります）。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>どうやって会員登録しますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>「LINEで無料で始める」からLINEでログインするだけで登録できます。メールアドレスやパスワードの入力はいりません。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>ポイントはいつもらえますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>条件を達成すると、まず「判定中」として反映されます。広告主の承認後に「確定」となり、交換に使えるようになります。</p></div>
        </details>
        <details>
          <summary><span class="faq__mark faq__mark--q" aria-hidden="true">Q</span><span>困ったときは誰に相談できますか？</span></summary>
          <div class="faq__answer"><span class="faq__mark faq__mark--a" aria-hidden="true">A</span><p>ポイフォ公式LINEを友だち追加すると、担当スタッフに相談できます。</p></div>
        </details>
      </div>
      <a class="more-link" href="/guide/">ヘルプをもっと見る</a>
    </div>
  </section>

  <!-- ⑩ 最後の登録導線（未ログインのときだけ） -->
  <section class="section section--wave final-cta" data-show="guest">
    <div class="container">
      <p class="final-cta__copy">ひとりじゃない、あたらしいポイ活をはじめよう。</p>
      <a class="btn btn--line" href={LINE_LOGIN_URL}>LINEで無料で始める</a>
    </div>
  </section>

  <!-- ページの一番下: フッターの上の縁から、のぞき込むポイフォックス（ログイン中のトップはこの1体だけ） -->
  <div class="page-end" aria-hidden="true">
    <Mascot pose="peek" width={120} class="peek peek--end" />
  </div>
</BaseLayout>

<script>
  import { fetchCampaignCategories, fetchCampaigns, fetchEvents, fetchNews } from '../lib/api';
  import { categoryIcon } from '../lib/category-icon';
  import { bindFavoriteButtons } from '../lib/favorite';
  import { escapeHtml, formatPoints, formatPointsNumber } from '../lib/format';
  import { campaignCard, emptyState, eventCard } from '../lib/render';
  import { whenMe } from '../lib/session';

  // ログイン中: 保有ポイントの帯と、重要なお知らせ（公開中の新しい1件）
  whenMe().then((me) => {
    if (!me) return;
    loadCategories();
    document.getElementById('member-available')!.textContent = formatPointsNumber(me.points.available);
    document.getElementById('member-pending')!.textContent = formatPoints(me.points.pending);
    fetchNews({ important: true, perPage: 1 })
      .then((res) => {
        const n = res.data[0];
        if (!n) return;
        const el = document.getElementById('important-news') as HTMLAnchorElement;
        el.href = `/news/detail/?id=${n.id}`;
        el.innerHTML = `<span class="badge badge--important">重要</span><span>${escapeHtml(n.title)}</span>`;
        el.hidden = false;
      })
      .catch(() => undefined);
  });

  // カテゴリは ASP から取り込んだ案件の分類（件数の多い順）。ログイン中だけ出すので、ログインが分かってから読む
  function loadCategories() {
    const categories = document.getElementById('campaign-categories')!;
    fetchCampaignCategories()
      .then((items) => {
        categories.innerHTML = items.length
          ? items
              .slice(0, 8)
              .map(
                (c) =>
                  `<li><a class="category-tile" href="/campaigns/?category=${encodeURIComponent(c.name)}">${categoryIcon(c.name)}<span class="category-tile__name">${escapeHtml(c.name)}</span><span class="category-tile__count">${c.count}件</span></a></li>`,
              )
              .join('')
          : emptyState('カテゴリは準備中です。', undefined, 'li');
      })
      .catch(() => (categories.innerHTML = emptyState('カテゴリを読み込めませんでした。', undefined, 'li')));
  }

  const campaigns = document.getElementById('featured-campaigns')!;
  bindFavoriteButtons(campaigns);
  fetchCampaigns({ featured: true, perPage: 6 })
    .then(async (res) => {
      // おすすめが未設定なら新着を出す
      const items = res.data.length ? res.data : (await fetchCampaigns({ perPage: 6 })).data;
      campaigns.innerHTML = items.length ? items.map((c) => campaignCard(c)).join('') : emptyState('現在掲載中の案件はありません。');
    })
    .catch(() => (campaigns.innerHTML = emptyState('案件を読み込めませんでした。時間をおいて再度お試しください。')));

  const events = document.getElementById('upcoming-events')!;
  fetchEvents({ upcoming: true, limit: 3 })
    .then((items) => (events.innerHTML = items.length ? items.map(eventCard).join('') : emptyState('開催予定のイベントは準備中です。')))
    .catch(() => (events.innerHTML = emptyState('イベントを読み込めませんでした。')));
</script>

<style>
  .member-top {
    padding: 16px 0 0;
  }
  .member-top .important-news {
    margin-bottom: 0;
  }
  /* ファーストビュー: キービジュアル（白地）の下に、淡いアクアの帯で主ボタンとチップを置く。
     帯の上の縁に、のぞき込むポイフォックス（下端が手で切れた絵）の手を乗せる */
  .hero__kv {
    position: relative;
  }
  .hero__kv :global(.peek--kv) {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 28%;
    height: auto;
    transform: translateX(-50%);
  }
  .hero__inner {
    padding-top: 20px;
    padding-bottom: 24px;
    text-align: center;
    background: linear-gradient(180deg, var(--color-brand-bg), #fff);
  }
  .hero__btn {
    width: 100%;
  }
  .hero__chips {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .hero__chips li {
    padding: 3px 12px;
    border: 1px solid var(--color-brand);
    border-radius: 999px;
    background: #fff;
    font-size: 0.8rem;
  }
  /* 案件メニュー: 画像の上の行ごとに透明なリンク。押せる場所が分かるよう、触れた行をうっすら暗くし、キーボードの枠も出す */
  .campaign-menu {
    position: relative;
  }
  .campaign-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .campaign-menu li {
    position: absolute;
    left: 3.7%;
    width: 92.5%;
  }
  .campaign-menu a {
    display: block;
    height: 100%;
    border-radius: 14px;
  }
  .campaign-menu a:hover,
  .campaign-menu a:active {
    background: rgb(0 0 0 / 0.04);
  }
  .campaign-menu a:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 2px;
  }
  /* 説明の画像はコンテナいっぱいに出す（画像の中に左右の余白がある） */
  .section-visual,
  .section :global(.section-visual) {
    display: block;
    width: 100%;
    height: auto;
  }
  .section-btn {
    display: flex;
    margin-top: 8px;
  }
  .events-band {
    padding-top: 16px;
  }
  .events-band__lead {
    margin: -4px 0 12px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  /* ログイン中は帯ではなく、コンテナの中の水色の囲みにする */
  :global(body[data-auth='member']) .events-band {
    padding-top: 0;
    background: none;
  }
  :global(body[data-auth='member']) .events-band > .container {
    width: auto;
    margin: 0 12px;
    overflow: hidden;
    padding-top: 16px;
    padding-bottom: 8px;
    border-radius: 16px;
    background: var(--color-brand-bg);
  }
  /* カテゴリのタイル: アイコン → 名前 → 件数。スマホ幅でも4列 */
  .category-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .category-tiles > :global(li:only-child) {
    grid-column: 1 / -1;
  }
  .category-tiles :global(.category-tile) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: 100%;
    min-height: 96px;
    padding: 8px 4px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.04);
    text-align: center;
    text-decoration: none;
  }
  .category-tiles :global(.category-tile:hover) {
    border-color: var(--color-brand);
  }
  .category-tiles :global(.category-tile__icon) {
    color: var(--color-brand-strong);
    margin-bottom: 2px;
  }
  .category-tiles :global(.category-tile__name) {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .category-tiles :global(.category-tile__count) {
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  /* 担当サポート（ログイン中）: 左に説明とボタン、右に絵 */
  .support-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .support-box__body {
    flex: 1;
    min-width: 0;
  }
  .support-box__body p {
    margin: 0 0 12px;
    font-size: 0.85rem;
  }
  .support-box__btn {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.85rem;
  }
  .support-box :global(.support-box__img) {
    flex-shrink: 0;
    width: 40%;
    height: auto;
  }
  .faq-intro {
    margin: 0 0 16px;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  .faq {
    display: grid;
    gap: 8px;
  }
  .faq details {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .faq summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 40px 12px 14px;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    position: relative;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  /* 開閉の印（＋／－） */
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 16px;
    color: var(--color-muted);
    font-size: 1.2rem;
