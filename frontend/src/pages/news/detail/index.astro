---
// お知らせ詳細（docs/specs/screen-spec.md S23）。/news/detail/?id=123
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="お知らせ">
  <section class="section">
    <div class="container" id="news" aria-live="polite">
      <p class="loading">読み込み中…</p>
    </div>
    <div class="container">
      <a class="more-link" href="/news/">お知らせ一覧に戻る</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { ApiError, fetchNewsDetail } from '../../../lib/api';
  import { escapeHtml, formatDate, linkify } from '../../../lib/format';
  import { emptyState, loadError } from '../../../lib/render';

  const root = document.getElementById('news')!;
  const id = new URLSearchParams(location.search).get('id');

  async function render() {
    if (!id) {
      root.innerHTML = emptyState('お知らせが見つかりません。', 'sorry');
      return;
    }
    try {
      const n = await fetchNewsDetail(id);
      document.title = `${n.title}｜お知らせ｜ポイフォ`;
      root.innerHTML = `
        <article class="news-article">
          <p class="news-article__date">${n.published_at ? escapeHtml(formatDate(n.published_at)) : ''}${n.is_important ? '<span class="badge badge--important">重要</span>' : ''}</p>
          <h1 class="news-article__title">${escapeHtml(n.title)}</h1>
          <div class="prose news-article__body">${linkify(n.body)}</div>
        </article>`;
    } catch (e) {
      root.innerHTML = e instanceof ApiError && e.status === 404 ? emptyState('お知らせが見つかりません。', 'sorry') : loadError('お知らせを読み込めませんでした。時間をおいて再度お試しください。');
    }
  }
  render();
</script>

<style>
  #news :global(.news-article__date) {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  #news :global(.news-article__title) {
    margin: 4px 0 16px;
    font-size: 1.2rem;
    font-weight: 600;
  }
  #news :global(.news-article__body) {
    overflow-wrap: anywhere;
  }
  #news :global(.news-article__body a) {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-underline-offset: 3px;
  }
</style>
