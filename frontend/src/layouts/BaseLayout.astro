---
// サイトの文字は M PLUS Rounded 1c（2026-11-27 お試し。先方の画像の文字にいちばん近い丸ゴシック）。
// 外部に頼らないようビルドに同梱する（@fontsource。日本語は文字の範囲ごとに分かれていて、ページで使う分だけ読み込まれる）。
// 本文 400、太字 700、見出しとボタン 800（画像の文字の太さに合わせる）
import '@fontsource/m-plus-rounded-1c/400.css';
import '@fontsource/m-plus-rounded-1c/700.css';
import '@fontsource/m-plus-rounded-1c/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideNav from '../components/SideNav.astro';
import SideAside from '../components/SideAside.astro';
import { LINE_LOGIN_URL } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  /** ログイン必須のページ。未ログインなら /login/ へ移動する */
  requireLogin?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'ひとりじゃない、あたらしいポイ活。案件を探して、担当スタッフに相談して、みんなでポイ活。',
  requireLogin = false,
  noindex = false,
} = Astro.props;
// スマホで画面下に追従する登録ボタン。マイページ・ログイン・認証まわり（noindex）では出さない
const stickyCta = !requireLogin && !noindex;
const fullTitle = title ? `${title}｜ポイフォ` : 'ポイフォ｜あなたのポイ活を、フォロー。';
// SNS で共有されたときの画像（納品の banner-wide-1-easy を 1200×630 にしたもの）。OGP は絶対 URL が要るので site（PUBLIC_SITE_URL）から組み立てる
const ogImage = new URL('/images/ogp.jpg', Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/images/poifo-logo-header.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ポイフォでかんたんポイ活" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-auth="unknown" data-require-login={requireLogin ? 'true' : undefined} data-sticky-cta={stickyCta ? 'true' : undefined}>
    <!-- PC はスマホ幅の画面を中央に置き、左にメニュー・右に案内を出す（スマホと同じ画面で見せるため） -->
    <div class="shell">
      <aside class="shell__side shell__side--left"><SideNav /></aside>
      <div class="shell__center">
    <Header />
    <main>
      <slot />
    </main>
    {
      requireLogin && (
        <section class="section" id="auth-error" hidden>
          <div class="container narrow">
            <p class="notice">サーバーに接続できませんでした。時間をおいて再読み込みしてください。</p>
          </div>
        </section>
      )
    }
    <Footer />
      </div>
      <aside class="shell__side shell__side--right"><SideAside /></aside>
    </div>
    {
      stickyCta && (
        <div class="sticky-cta" data-show="guest" id="sticky-cta">
          <a class="btn btn--line btn--block" href={LINE_LOGIN_URL}>LINEで無料で始める</a>
        </div>
      )
    }
    <script>
      import { fetchMe } from '../lib/api';
      import { setMe } from '../lib/session';
      import { withReferral } from '../lib/referral';

      // 紹介URLから来た人は、どの「LINEでログイン」から登録しても紹介コードが付くようにする（スクリプトで後から出すボタンも含めて押したときに付ける）
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href*="/auth/line/redirect"]') as HTMLAnchorElement | null;
        if (a) a.href = withReferral(a.href);
      });

      // 追従ボタンと同じ登録ボタンがページ内で見えている間は、追従ボタンを引っ込めて二重に見せない
      const sticky = document.getElementById('sticky-cta');
      if (sticky && 'IntersectionObserver' in window) {
        const inPage = document.querySelectorAll('main .btn--line[href*="/auth/line/redirect"]');
        const visible = new Set<Element>();
        const observer = new IntersectionObserver((entries) => {
          for (const e of entries) (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target));
          sticky.classList.toggle('sticky-cta--away', visible.size > 0);
        });
        inPage.forEach((el) => observer.observe(el));
      }

      // ログイン状態を API に問い合わせて、ヘッダーなどの表示を切り替える
      fetchMe()
        .then((me) => {
          document.body.dataset.auth = me ? 'member' : 'guest';
          if (!me && document.body.dataset.requireLogin === 'true') {
            location.replace('/login/');
            return;
          }
          setMe(me);
        })
        .catch(() => {
          // API に届かないときは未ログイン扱い。ログイン必須のページは中身を出さずにお知らせだけ表示する
          document.body.dataset.auth = 'guest';
          const error = document.getElementById('auth-error');
          if (error) error.hidden = false;
          setMe(null);
        });
    </script>
  </body>
</html>
