---
// 障害・メンテナンスのときに出す単体ページの共通レイアウト（500 ページ・メンテナンス画面）。
// そのとき API やほかのファイルが読めなくても表示できるよう、共通 CSS（global.css）・BaseLayout・/v1/me に頼らず、
// CSS はこのファイルに直接書く（ビルドで HTML に埋め込まれる）。色は global.css と同じ値（変えるときは両方そろえる）。
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}｜ポイフォ</title>
    <link rel="icon" type="image/png" href="/images/poifo-logo-header.png" />
    <style is:inline>
      :root {
        --color-text: #1a1e21;
        --color-muted: #5f6b70;
        --color-brand: #3ad1ce;
        --color-accent-strong: #b45a00;
        --color-page-bg: #eef7f7;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background: var(--color-page-bg);
        color: var(--color-text);
        font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
        line-height: 1.7;
      }
      /* PC でもスマホ幅の画面を中央に置く（通常ページと同じ見え方） */
      .screen {
        max-width: 480px;
        min-height: 100vh;
        margin: 0 auto;
        background: #fff;
        padding: 24px 16px 40px;
        text-align: center;
      }
      .logo { display: block; width: 120px; height: auto; margin: 0 auto 24px; }
      .mascot { display: block; height: auto; margin: 0 auto 8px; }
      .code { margin: 0; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.08em; color: var(--color-accent-strong); }
      h1 { margin: 4px 0 12px; font-size: 1.4rem; font-weight: 600; line-height: 1.4; }
      .text { margin: 0 0 24px; color: var(--color-muted); text-align: left; }
      .actions { display: grid; gap: 12px; }
      .btn {
        display: block;
        padding: 12px 20px;
        border-radius: 999px;
        border: 2px solid var(--color-text);
        background: var(--color-text);
        color: #fff;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }
      .btn--outline { background: #fff; color: var(--color-text); border-color: var(--color-brand); }
    </style>
  </head>
  <body>
    <main class="screen">
      <a href="/"><img class="logo" src="/images/poifo-logo-header.png" alt="ポイフォ" width="120" height="51" /></a>
      <slot />
    </main>
  </body>
</html>
