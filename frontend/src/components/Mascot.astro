---
// キャラクター「ポイフォックス」の画像。
// 大きさの一覧は src/lib/mascot.ts（ブラウザ側で空・エラー表示を作るときと共通）。
// width/height を必ず付けて、読み込み中にレイアウトがずれないようにする。
import { mascotHeight, type MascotPose } from '../lib/mascot';

export type { MascotPose };

interface Props {
  pose: MascotPose;
  /** 表示幅(px)。高さは縦横比から決まる */
  width: number;
  /** 装飾なら空文字（既定）。画像だけで意味を伝えるときに説明を入れる */
  alt?: string;
  /** ファーストビューの画像だけ true（それ以外は遅延読み込み） */
  eager?: boolean;
  class?: string;
}

const { pose, width, alt = '', eager = false, class: className } = Astro.props;
---

<img
  src={`/images/mascot/poifox-${pose}.webp`}
  width={width}
  height={mascotHeight(pose, width)}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['mascot', className]}
/>
