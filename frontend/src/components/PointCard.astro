---
// ポイント表示の共通カード（src/lib/point-card.ts と同じ見た目）。数字と判定中はページのスクリプトで id を探して書き込む
interface Props {
  label: string;
  /** 数字を書き込む要素の id */
  valueId: string;
  /** 判定中ポイントを書き込む要素の id（出さないなら省略） */
  sideId?: string;
  sideLabel?: string;
  href?: string;
}
const { label, valueId, sideId, sideLabel = '判定中ポイント', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="point-card" href={href}>
  <span class="point-card__badge" aria-hidden="true"><span>P</span></span>
  <span class="point-card__main">
    <span class="point-card__label">{label}</span>
    <span class="point-card__value"
      ><span class="point-card__num" id={valueId}>—</span><span class="point-card__unit">P</span><svg
        class="point-card__sparkle"
        viewBox="0 0 24 24"
        width="22"
        height="22"
        aria-hidden="true"
        ><path d="M6 3.5 7.5 9M13 5l-2.5 5M20 10.5l-6 2" stroke="#f5c400" stroke-width="2.6" stroke-linecap="round" fill="none"></path></svg
      ></span
    >
  </span>
  {
    sideId && (
      <span class="point-card__side">
        <span class="point-card__side-label">{sideLabel}</span>
        <span class="point-card__side-value" id={sideId}>
          —
        </span>
      </span>
    )
  }
</Tag>
