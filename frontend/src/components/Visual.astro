---
// 納品のキービジュアル・バナー・説明画像（docs/brand/README.md の割り当て表）。
// 画像は public/images/visuals/ の書き出し済み WebP（原本は共有フォルダ brand/visuals/original/、幅960px＝480px表示の2倍）。
// width/height を必ず付けて、読み込み中にレイアウトがずれないようにする。
// 文字が入った画像は alt に画像内の文言を入れる（検索・読み上げ用）。
const sizes = {
  // S01 トップ（2026-11-27 納品のデザイン更新。セクション画像は角の波を消して上下の余白を詰めたもの）
  'kv-hitori-janai': [960, 1200], // ファーストビュー
  'section-category-menu': [960, 1022], // 案件メニュー5行（上に透明なリンクを重ねる）
  'section-minna-de-poikatsu': [960, 993], // みんなでポイ活
  'section-staff-consult': [960, 1034], // 担当スタッフに相談
  'section-features': [960, 1091], // ポイフォの特徴
  'section-how-to-earn': [960, 1109], // ポイントの貯め方
  'section-how-points-work': [960, 976], // ポイントがもらえるしくみ
  // S01 ログイン中（2026-11-28 の見本 member-top/ から切り出し、背景を透過にしたもの）
  'member-support': [344, 218], // 担当サポートの絵（スマホ・吹き出し・人々）
  'how-points-work': [960, 809], // S15 ヘルプのポイントがもらえるしくみ（下の余白は切り詰め済み）
  'banner-wide-3-shopping': [960, 480], // S02 案件一覧
  'banner-wide-4-start': [960, 540], // S15 はじめての方へ・ヘルプ
  'kv-tall-follow-b': [960, 1440], // S14 担当サポート
} as const;

export type VisualName = keyof typeof sizes;

interface Props {
  name: VisualName;
  /** 画像内の文言・説明。文章で意味が伝わる場所の装飾なら空文字 */
  alt: string;
  /** ファーストビュー・ページ上部の画像だけ true（それ以外は遅延読み込み） */
  eager?: boolean;
  class?: string;
}

const { name, alt, eager = false, class: className } = Astro.props;
const [w, h] = sizes[name];
---

<img
  src={`/images/visuals/${name}.webp`}
  width={w}
  height={h}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class:list={['visual', className]}
/>
